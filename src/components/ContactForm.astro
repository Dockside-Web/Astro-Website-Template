---
import { site } from "../site.config";

const basinURL = `https://usebasin.com/f/${site.forms.basinId}`;
const { turnstileSiteKey } = site.forms;

const inputClass =
  "focus:border-brand-secondary focus:ring-brand-secondary w-full rounded-lg border border-gray-300 px-4 py-2 transition-all outline-none focus:ring-1";
const labelClass = "mb-1 block text-sm font-medium text-gray-700";
---

<div class="mb-2 w-full max-w-2xl rounded-2xl border border-gray-100 bg-white p-8 shadow-sm">
  <form id="contact-form" data-turnstile={turnstileSiteKey ? "true" : "false"} action={basinURL} method="POST" class="space-y-5">
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      <div>
        <label for="name" class={labelClass}>Full Name <span class="text-red-500" aria-hidden="true">*</span></label>
        <input type="text" id="name" name="name" placeholder="John Doe" autocomplete="name" required class={inputClass} />
      </div>

      <div>
        <label for="company" class={labelClass}>Company (optional)</label>
        <input
          type="text"
          id="company"
          name="company"
          placeholder="Company Name, LLC"
          autocomplete="organization"
          class={inputClass}
        />
      </div>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      <div>
        <label for="email" class={labelClass}>Email Address <span class="text-red-500" aria-hidden="true">*</span></label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="you@example.com"
          autocomplete="email"
          required
          class={inputClass}
        />
      </div>

      <div>
        <label for="phone" class={labelClass}>Phone Number</label>
        <input type="tel" id="phone" name="phone" placeholder="(555) 000-0000" autocomplete="tel" class={inputClass} />
      </div>
    </div>

    <div class="space-y-1">
      <label for="message" class={labelClass}>Message <span class="text-red-500" aria-hidden="true">*</span></label>
      <textarea id="message" name="message" rows="4" placeholder="How can we help?" required class:list={[inputClass, "resize-none"]}
      ></textarea>

      <p class="text-[10px] leading-none text-gray-400 italic">
        Fields marked with <span class="text-red-500">*</span> are required.
      </p>
    </div>

    <!-- Cloudflare Turnstile widget -->
    {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-callback="turnstileFinished" data-theme="light" />}

    <!-- Hidden honeypot field. Needs to have the same name as the one configured in Basin to work correctly. -->
    <div class="absolute top-0 -left-600 h-0 overflow-hidden" aria-hidden="true">
      <label for="_botvortex">Leave this field empty</label>
      <input type="text" id="_botvortex" name="_botvortex" tabindex="-1" autocomplete="off" />
    </div>

    <button
      type="submit"
      id="submit-btn"
      disabled
      class="bg-brand-primary w-full rounded-lg px-6 py-3 font-semibold text-white shadow-md transition-all duration-200 hover:shadow-lg hover:brightness-110 active:scale-[0.98] disabled:cursor-not-allowed disabled:bg-gray-300 disabled:shadow-none"
    >
      Send Message
    </button>
  </form>
</div>

<!-- Loaded here (not in Layout) so pages without a form don't pay for it -->
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

<script>
  declare global {
    interface Window {
      turnstileFinished?: () => void;
    }
  }

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const requiredInputs = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[required]");

  // Skip the Turnstile check if no site key is set in site.config.ts
  let isTurnstileVerified = form.dataset.turnstile !== "true";

  // Only enable if all required fields are filled AND Turnstile has passed
  const checkFormValidity = () => {
    const allFieldsFilled = Array.from(requiredInputs).every((input) => input.value.trim() !== "");
    submitBtn.disabled = !(allFieldsFilled && isTurnstileVerified);
  };

  // Called by Cloudflare when the check is passed
  window.turnstileFinished = () => {
    isTurnstileVerified = true;
    checkFormValidity();
  };

  requiredInputs.forEach((input) => input.addEventListener("input", checkFormValidity));

  // Prevent double submits
  form.addEventListener("submit", () => {
    submitBtn.disabled = true;
    submitBtn.textContent = "Sending…";
  });
</script>
